char infix[MAX], postfix[MAX], stack[MAX];//stack-stores operators and opening parentheses during conversion.
char operands[MAX][MAX];
//top tracks the top position of the operator stack,
//ptop tracks the top position of the operands stack used during TAC generation.
int top = -1, ptop = -1, temp = 1;

int priority(char op)
{
    if (op == '*' || op == '/')
        return 2;
    if (op == '+' || op == '-')
        return 1;
    return 0;//(
}

void infixToPostfix(char expr[])
{
    int i, j = 0;
    char ch;

    for (i = 0; expr[i] != '\0'; i++)
    {
        ch = expr[i];

        if (isalnum((unsigned char)ch))//If it is an operand, it is directly added to the postfix expression.
            postfix[j++] = ch;//postfix[j] = ch;j++;

        else if (ch == '(')
            stack[++top] = ch;

        else if (ch == ')')
        {
            while (top != -1 && stack[top] != '(')
                postfix[j++] = stack[top--];

            if (top != -1)
                top--;
        }
        else
        {
            while (top != -1 && stack[top] != '(' &&
                   priority(stack[top]) >= priority(ch))
                postfix[j++] = stack[top--];

            stack[++top] = ch;
        }
    }

    while (top != -1)
        postfix[j++] = stack[top--];

    postfix[j] = '\0';
}

