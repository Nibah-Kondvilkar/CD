Code:
//Design a program to eliminate left recursion
#include <stdio.h>
#include <string.h>

int main() {
    char production[100];
    char non_terminal;
    char alpha[10][10], beta[10][10];
    int alpha_count = 0, beta_count = 0;

    printf("Enter production rule (e.g., E->E+T|T): ");
    if (scanf("%99s", production) != 1) {
        printf("Error reading input.\n");
        return 1;
    }

    // The first character is the non-terminal variable
    non_terminal = production[0];

    // Validate structural position of "->"
    if (production[1] != '-' || production[2] != '>') {
        printf("Invalid production format. Use '->'\n");
        return 1;
    }

    // Parse the right hand side using production string slicing
    // Start tokenizing from index 3 (after the "->")
    char *rhs = production + 3;
    char *token = strtok(rhs, "|");

    while (token != NULL) {
        // If the token starts with the parent non-terminal, it's left recursive (alpha)
        if (token[0] == non_terminal) {
            strcpy(alpha[alpha_count], token + 1); // Store everything after the non-terminal
            alpha_count++;
        } else {
            // Otherwise, it's a non-left-recursive alternative (beta)
            strcpy(beta[beta_count], token);
            beta_count++;
        }
        token = strtok(NULL, "|");
    }

    // Output the results
    if (alpha_count == 0) {
        printf("\nThe grammar does not contain immediate left recursion.\n");
    } else {
        printf("\n--- Grammars after eliminating Left Recursion ---\n");

        // Print the revised A rules
        printf("%c -> ", non_terminal);
        for (int i = 0; i < beta_count; i++) {
            printf("%s%c'", beta[i], non_terminal);
            if (i < beta_count - 1) printf(" | ");
        }
        printf("\n");

        // Print the new A' rules
        printf("%c' -> ", non_terminal);
        for (int i = 0; i < alpha_count; i++) {
            printf("%s%c' | ", alpha[i], non_terminal);
        }
        printf("e\n"); // 'e' represents epsilon (empty string)
    }

    return 0;
}


