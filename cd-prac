/* FIRST and FOLLOW sets - simple C program
   Input format: one production per line, with no spaces in RHS.
   Use | for alternatives only by entering each alternative separately.
   Example:
       E TX
       X +TX
       X e
       T FY
       Y *FY
       Y e
       F (E)
       F i
       # #
   Here e represents epsilon.
   Uppercase letters are non-terminals; other characters are terminals.
*/

#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX_PROD 50
#define MAX_LEN  50

char lhs[MAX_PROD];
char rhs[MAX_PROD][MAX_LEN];
int n = 0;

/* Set membership is stored by character code. */
int firstSet[128][128];//firstSet['F']['i'] = 1;  i belongs FIRST(F)
int followSet[128][128];//followSet['E'][')'] = 1;  ) belongs FOLLOW(E)
int used[128];

int isNT(char c) {
    return isupper((unsigned char)c);//returns a nonzero value when c is uppercase and zero otherwise.
}

void readGrammar(void) {
    char left[20], right[MAX_LEN];
    int i;
/*E TX
left = "E"
right = "TX"*/
    printf("Enter each production as: LHS RHS\n");
    printf("Example: E TX\n");
    printf("Enter e for epsilon and # # to finish.\n\n");

    while (n < MAX_PROD && scanf("%19s %49s", left, right) == 2) {
        if (strcmp(left, "#") == 0 && strcmp(right, "#") == 0)
            break;
/*//The LHS must contain exactly one character.For example, E is accepted, but Expr is rejected.
The LHS must be uppercase.
The ! operator means logical NOT.
For example, lowercase e is rejected as an LHS.
The RHS must not be empty.
If any condition is true, the production is rejected.
The continue statement skips the rest of the current loop iteration and reads the next production.*/
        if (strlen(left) != 1 || !isNT(left[0]) || right[0] == '\0') {
            printf("Invalid production. LHS must be one uppercase letter.\n");
            continue;
        }

        lhs[n] = left[0];//E TX lhs[0] = 'E'
        strcpy(rhs[n], right);//rhs[0] = "TX"
        used[(unsigned char)left[0]] = 1;//used['E'] = 1;

        for (i = 0; right[i] != '\0'; i++)//+TX -- +, T, X
            if (right[i] != 'e')
                used[(unsigned char)right[i]] = 1;

        n++;
    }
}

/* Add FIRST of one symbol to FIRST of a non-terminal.
   Returns 1 if any new item was added. */
int addFirst(char A, char symbol) {
    unsigned char a = (unsigned char)A;//A = 'E' symbol = 'i'
    unsigned char s = (unsigned char)symbol;

    if (!firstSet[a][s]) {//firstSet['E']['i']
        firstSet[a][s] = 1;
        return 1;
    }
    return 0;
}

void calculateFirst(void) {
    /*changed: indicates whether a FIRST set changed during the current pass.
i: indexes productions.
j: indexes characters in an RHS.
allNullable: tracks whether all relevant RHS symbols can derive epsilon.
A: the current LHS non-terminal.
r: a pointer to the current RHS string.*/
    int changed = 1, i, j, allNullable;
    char A, *r;
    while (changed) {
        changed = 0;//Whenever a new FIRST-set member is added, the program sets changed to a nonzero value.

        for (i = 0; i < n; i++) {//F → i
            A = lhs[i];
            r = rhs[i];//A = 'F' r = "i"

            /* Production A -> e */
            if (strcmp(r, "e") == 0) {
                changed |= addFirst(A, 'e');//FIRST(X) = { e }
                continue;
            }
            allNullable = 1;
            /*Initially assumes that all symbols in the RHS can derive epsilon.
If the program encounters a terminal or a non-nullable non-terminal, it changes allNullable to 0.
This variable helps determine whether the entire RHS can derive epsilon.*/

            /* Examine RHS from left to right. */
            for (j = 0; r[j] != '\0'; j++) {//E → TX  T X
                char X = r[j];//X → +TX first RHS character is +, which is a terminal.
                if (!isNT(X)) {
                    changed |= addFirst(A, X);
                    allNullable = 0;//indicates that the entire RHS cannot derive epsilon through this position because a terminal cannot disappear.
                    break;
                }

                /* Add FIRST(X), except epsilon, to FIRST(A). handles the case where X is a non-terminal.*/
                {
                    int t;
                    /*Checks two conditions:
1. The symbol is not epsilon.
2. The symbol belongs to FIRST(X)*/
                    for (t = 0; t < 128; t++) {
                        if (t != 'e' && firstSet[(unsigned char)X][t])
                            changed |= addFirst(A, (char)t);//FIRST(T) = { (, i } E → TX The program copies ( and i into FIRST(E).
                    }
                }
                /* If X cannot derive epsilon, stop here. If epsilon is absent from FIRST(X), then the current non-terminal cannot disappear.*/
                if (!firstSet[(unsigned char)X][(unsigned char)'e']) {
                    allNullable = 0;//and stops examining the remaining RHS symbols.If epsilon is in FIRST(X), the loop continues to the next symbol.
                    break;
                }
            }//E → TX If T cannot derive epsilon, only FIRST(T) contributes to FIRST(E), and the program does not continue to X.If T can derive epsilon, the program also considers FIRST(X).

            /* If every RHS symbol can derive epsilon, A can derive epsilon. */
            if (allNullable)
                changed |= addFirst(A, 'e');//X → e FIRST(X) = { e }
        }//If every symbol in the RHS can derive epsilon, the entire RHS can derive epsilon.Therefore, epsilon is added to FIRST(A)
    }
}
void calculateFollow(void) {
    int changed = 1, i, j, k, nullable;
    char start = lhs[0];

    /* End marker belongs to FOLLOW(start symbol). */
    followSet[(unsigned char)start][(unsigned char)'$'] = 1;

    while (changed) {
        changed = 0;
        for (i = 0; i < n; i++) {
            char A = lhs[i];
            char *r = rhs[i];

            if (strcmp(r, "e") == 0)
                continue;
/*The loop visits every RHS character.
B stores the current character.
If B is a terminal, the program skips it because FOLLOW sets are calculated for non-terminals.
If B is a non-terminal, the program examines what comes after it.*/
            for (j = 0; r[j] != '\0'; j++) {
                char B = r[j];

                if (!isNT(B))
                    continue;

                /* Add FIRST of the suffix after B, excluding epsilon. */
                nullable = 1;//The program initially assumes that everything after B can derive epsilon.

                for (k = j + 1; r[k] != '\0'; k++) {
                    char X = r[k];

                    if (!isNT(X)) {
                        if (X != 'e' &&
                            !followSet[(unsigned char)B][(unsigned char)X]) {
                            followSet[(unsigned char)B][(unsigned char)X] = 1;//If X is a terminal, it can be added directly to FOLLOW(B).
                            changed = 1;
                        }
                        nullable = 0;
                        break;
                    }

                    {
                        int t;//This block handles the case where X is a non-terminal.It copies the terminals from FIRST(X) into FOLLOW(B), excluding epsilon.
                        for (t = 0; t < 128; t++) {
                            if (t != 'e' && firstSet[(unsigned char)X][t] &&
                                !followSet[(unsigned char)B][t]) {
                                followSet[(unsigned char)B][t] = 1;
                                changed = 1;
                            }
                        }
                    }
/*If X cannot derive epsilon, the suffix cannot disappear at this position.
Therefore, the program sets nullable = 0 and stops examining the suffix.
If X can derive epsilon, the loop continues to the next symbol.
This is how the program handles productions where one or more non-terminals may derive an empty string.*/
                    if (!firstSet[(unsigned char)X][(unsigned char)'e']) {
                        nullable = 0;
                        break;
                    }
                }

                /* If suffix is empty or nullable, add FOLLOW(A) to FOLLOW(B). */
                if (nullable) {
                    int t;
                    for (t = 0; t < 128; t++) {
                        if (followSet[(unsigned char)A][t] &&
                            !followSet[(unsigned char)B][t]) {
                            followSet[(unsigned char)B][t] = 1;
                            changed = 1;
                        }
                    }
                }
            }
        }
    }
}

void printSets(void) {
    int A, t;
    printf("\nFIRST sets:\n");
    for (A = 0; A < 128; A++) {
        if (used[A] && isNT((char)A)) {
            printf("FIRST(%c) = { ", A);
            for (t = 0; t < 128; t++)
                if (firstSet[A][t])
                    printf("%c ", t);
            printf("}\n");
        }
    }

    printf("\nFOLLOW sets:\n");
    for (A = 0; A < 128; A++) {
        if (used[A] && isNT((char)A)) {
            printf("FOLLOW(%c) = { ", A);
            for (t = 0; t < 128; t++)
                if (followSet[A][t])
                    printf("%c ", t);
            printf("}\n");
        }
    }
}

int main(void) {
    int i, j;
    readGrammar();

    if (n == 0) {
        printf("No productions entered.\n");
        return 1;
    }
    calculateFirst();
    calculateFollow();
    printSets();

    return 0;
}




