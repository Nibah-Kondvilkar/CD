            for (t = 0; t < 128; t++)
                if (lastVT[a][t] && !isNT((char)t)) printf("%c ", t);
            printf("}\n");
        }
}
void printOPM(void) {
    int a, b, bad = 0;
    printf("\nOperator Precedence Matrix:\n    ");
    for (b = 0; b < 128; b++)
